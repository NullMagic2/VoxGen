#version 460

layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer ModelBuffer { uint model_words[]; } model_buf;
layout(set = 0, binding = 1, std430) readonly buffer InputBuffer { float x[]; } in_buf;
layout(set = 0, binding = 2, std430) writeonly buffer OutputBuffer { float y[]; } out_buf;

layout(push_constant) uniform Push {
    uint weight_offset;
    uint bias_offset;
    uint rows;
    uint cols;
    uint weight_dtype;
    uint bias_dtype;
    uint row_base;
    float alpha;
} pc;

shared float partial[256];

uint load_u8(uint byte_offset) {
    uint word = model_buf.model_words[byte_offset >> 2u];
    uint shift = (byte_offset & 3u) * 8u;
    return (word >> shift) & 0xffu;
}

float load_f16(uint byte_offset) {
    uint word = model_buf.model_words[byte_offset >> 2u];
    uint shift = (byte_offset & 2u) * 8u;
    uint bits = (word >> shift) & 0xffffu;
    return unpackHalf2x16(bits).x;
}

float load_f32(uint byte_offset) {
    return uintBitsToFloat(model_buf.model_words[byte_offset >> 2u]);
}

float load_scalar(uint byte_offset, uint dtype) {
    if (dtype == 0u) return load_f32(byte_offset);
    if (dtype == 1u) return load_f16(byte_offset);
    return 0.0;
}

float load_weight(uint row, uint col) {
    if (pc.weight_dtype == 0u) {
        uint row_bytes = pc.cols * 4u;
        return load_f32(pc.weight_offset + row * row_bytes + col * 4u);
    }
    if (pc.weight_dtype == 1u) {
        uint row_bytes = pc.cols * 2u;
        return load_f16(pc.weight_offset + row * row_bytes + col * 2u);
    }
    // GGML_TYPE_Q8_0, retained for future quantized acoustic experiments.
    uint blocks_per_row = pc.cols / 32u;
    uint block = row * blocks_per_row + col / 32u;
    uint base = pc.weight_offset + block * 34u;
    float d = load_f16(base);
    uint raw = load_u8(base + 2u + (col & 31u));
    int q = raw < 128u ? int(raw) : int(raw) - 256;
    return d * float(q);
}

void main() {
    uint lane = gl_LocalInvocationID.x;
    uint row = pc.row_base + gl_WorkGroupID.x;
    if (row >= pc.rows) return;

    float sum = 0.0;
    for (uint col = lane; col < pc.cols; col += 256u) {
        sum += load_weight(row, col) * in_buf.x[col];
    }
    partial[lane] = sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (lane < stride) partial[lane] += partial[lane + stride];
        barrier();
    }
    if (lane == 0u) {
        float bias = load_scalar(pc.bias_offset + row * (pc.bias_dtype == 0u ? 4u : 2u), pc.bias_dtype);
        out_buf.y[row] = (partial[0] + bias) * pc.alpha;
    }
}
