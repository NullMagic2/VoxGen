#version 460

layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer ModelBuffer { uint model_words[]; } model_buf;
layout(set = 0, binding = 1, std430) readonly buffer InputBuffer { float x[]; } in_buf;
layout(set = 0, binding = 2, std430) writeonly buffer OutputBuffer { float y[]; } out_buf;

layout(push_constant) uniform Push {
    uint gate_weight_offset;
    uint up_weight_offset;
    uint rows;
    uint cols;
    uint dtype;
    uint row_base;
} pc;

shared float gate_partial[256];
shared float up_partial[256];

uint load_u8(uint byte_offset) {
    uint word = model_buf.model_words[byte_offset >> 2u];
    uint shift = (byte_offset & 3u) * 8u;
    return (word >> shift) & 0xffu;
}
float load_f16(uint byte_offset) {
    uint word = model_buf.model_words[byte_offset >> 2u];
    uint shift = (byte_offset & 2u) * 8u;
    uint bits = (word >> shift) & 0xffffu;
    return unpackHalf2x16(bits).x;
}
float load_weight(uint base_offset, uint row, uint col) {
    if (pc.dtype == 1u) {
        uint row_bytes = pc.cols * 2u;
        return load_f16(base_offset + row * row_bytes + col * 2u);
    }
    uint blocks_per_row = pc.cols / 32u;
    uint block = row * blocks_per_row + col / 32u;
    uint base = base_offset + block * 34u;
    float d = load_f16(base);
    uint raw = load_u8(base + 2u + (col & 31u));
    int q = raw < 128u ? int(raw) : int(raw) - 256;
    return d * float(q);
}
void main() {
    uint lane = gl_LocalInvocationID.x;
    uint row = pc.row_base + gl_WorkGroupID.x;
    if (row >= pc.rows) return;
    float gate_sum = 0.0;
    float up_sum = 0.0;
    for (uint col = lane; col < pc.cols; col += 256u) {
        float x = in_buf.x[col];
        gate_sum += load_weight(pc.gate_weight_offset, row, col) * x;
        up_sum += load_weight(pc.up_weight_offset, row, col) * x;
    }
    gate_partial[lane] = gate_sum;
    up_partial[lane] = up_sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (lane < stride) {
            gate_partial[lane] += gate_partial[lane + stride];
            up_partial[lane] += up_partial[lane + stride];
        }
        barrier();
    }
    if (lane == 0u) {
        float g = gate_partial[0];
        out_buf.y[row] = (g / (1.0 + exp(-g))) * up_partial[0];
    }
}
