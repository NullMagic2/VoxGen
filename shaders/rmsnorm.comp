#version 460

layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer ModelBuffer { uint model_words[]; } model_buf;
layout(set = 0, binding = 1, std430) readonly buffer InputBuffer { float x[]; } in_buf;
layout(set = 0, binding = 2, std430) writeonly buffer OutputBuffer { float y[]; } out_buf;

layout(push_constant) uniform Push {
    uint weight_offset;
    uint n;
    float eps;
} pc;

shared float partial[256];
shared float inv_rms;

float load_f32(uint byte_offset) {
    return uintBitsToFloat(model_buf.model_words[byte_offset >> 2u]);
}

void main() {
    uint lane = gl_LocalInvocationID.x;
    float sum = 0.0;
    for (uint i = lane; i < pc.n; i += 256u) {
        float v = in_buf.x[i];
        sum += v * v;
    }
    partial[lane] = sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (lane < stride) partial[lane] += partial[lane + stride];
        barrier();
    }
    if (lane == 0u) {
        inv_rms = inversesqrt(partial[0] / float(pc.n) + pc.eps);
    }
    barrier();
    for (uint i = lane; i < pc.n; i += 256u) {
        float w = load_f32(pc.weight_offset + i * 4u);
        out_buf.y[i] = in_buf.x[i] * inv_rms * w;
    }
}
