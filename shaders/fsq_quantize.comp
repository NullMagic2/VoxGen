#version 460

layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) buffer LatentBuffer { float values[]; } latent;
layout(push_constant) uniform Push { uint n; float scale; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    float v = tanh(latent.values[i]);
    latent.values[i] = round(v * pc.scale) / pc.scale;
}
