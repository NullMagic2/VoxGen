#version 460
layout(local_size_x=256) in;
layout(set=0,binding=0,std430) writeonly buffer Out{float x[];}ob;
layout(push_constant) uniform Push{uint dim;float t;}pc;
void main(){uint i=gl_GlobalInvocationID.x;if(i>=pc.dim)return;uint half_dim=pc.dim/2u;uint j=i%half_dim;float denom=float(max(half_dim-1u,1u));float freq=exp(float(j)*(-log(10000.0)/denom));float a=1000.0*pc.t*freq;ob.x[i]=i<half_dim?sin(a):cos(a);}
