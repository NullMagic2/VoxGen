#version 460
layout(local_size_x=1) in;
layout(set=0,binding=0,std430) buffer Scores{float s[];} sb;
layout(push_constant) uniform Push{uint tokens;uint q_heads;uint score_stride;}pc;
void main(){uint h=gl_WorkGroupID.x,t=gl_WorkGroupID.y;if(h>=pc.q_heads||t>=pc.tokens)return;uint b=(t*pc.q_heads+h)*pc.score_stride;float m=-3.402823e38;for(uint i=0;i<pc.tokens;i++)m=max(m,sb.s[b+i]);float z=0.0;for(uint i=0;i<pc.tokens;i++){float e=exp(sb.s[b+i]-m);sb.s[b+i]=e;z+=e;}for(uint i=0;i<pc.tokens;i++)sb.s[b+i]/=z;}
