#version 450
layout(local_size_x=256,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0,std430) buffer A { float a[]; };
layout(set=0,binding=1,std430) readonly buffer B { float b[]; };
layout(push_constant) uniform Push { uint channels; uint elem_count; } pc;
void main(){
    uint t=gl_GlobalInvocationID.x;
    uint c=gl_GlobalInvocationID.y;
    if(t>=pc.elem_count || c>=pc.channels) return;
    uint i=c*pc.elem_count+t;
    a[i]+=b[i];
}
