#version 460
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x=128)in;layout(set=0,binding=0,std430)readonly buffer Q{float q[];}qb;layout(set=0,binding=1,std430)readonly buffer K{uint w[];}kb;layout(set=0,binding=2,std430)writeonly buffer S{float s[];}sb;layout(push_constant)uniform Push{uint layer;uint context;uint position;uint head_dim;uint q_per_kv;uint kv_heads;}pc;shared float waves[4];float cache(uint layer,uint pos,uint dim){uint kvd=pc.kv_heads*pc.head_dim,wpt=kvd/2u,wi=(layer*pc.context+pos)*wpt+dim/2u;vec2 p=unpackHalf2x16(kb.w[wi]);return(dim&1u)==0u?p.x:p.y;}float red(float v){float w=subgroupAdd(v);if(gl_SubgroupInvocationID==0u)waves[gl_SubgroupID]=w;barrier();if(gl_SubgroupID==0u){float q=gl_SubgroupInvocationID<gl_NumSubgroups?waves[gl_SubgroupInvocationID]:0.0;q=subgroupAdd(q);if(gl_SubgroupInvocationID==0u)waves[0]=q;}barrier();return waves[0];}void main(){uint lane=gl_LocalInvocationID.x,t=gl_WorkGroupID.x,qh=gl_WorkGroupID.y;if(t>pc.position)return;uint kvh=qh/pc.q_per_kv;float v=lane<pc.head_dim?qb.q[qh*pc.head_dim+lane]*cache(pc.layer,t,kvh*pc.head_dim+lane):0.0;float z=red(v);if(lane==0u)sb.s[qh*pc.context+t]=z*inversesqrt(float(pc.head_dim));}
