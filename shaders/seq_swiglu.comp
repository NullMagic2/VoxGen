#version 460
layout(local_size_x=256) in;
layout(set=0,binding=0,std430) readonly buffer Model{uint w[];}model;
layout(set=0,binding=1,std430) readonly buffer Input{float x[];}input_buf;
layout(set=0,binding=2,std430) writeonly buffer Output{float y[];}output_buf;
layout(push_constant) uniform Push{uint gate_weight_offset;uint up_weight_offset;uint rows;uint cols;uint tokens;uint input_stride;uint output_stride;uint input_base;uint output_base;}pc;
shared float gp[256];shared float up[256];
float f16_at(uint o){uint v=model.w[o>>2u];uint b=(v>>((o&2u)*8u))&65535u;return unpackHalf2x16(b).x;}
void main(){uint lane=gl_LocalInvocationID.x,row=gl_WorkGroupID.x,tok=gl_WorkGroupID.y;if(row>=pc.rows||tok>=pc.tokens)return;uint ib=pc.input_base+tok*pc.input_stride;uint gr=pc.gate_weight_offset+row*pc.cols*2u,ur=pc.up_weight_offset+row*pc.cols*2u;float gs=0.0,us=0.0;for(uint c=lane;c<pc.cols;c+=256u){float x=input_buf.x[ib+c];gs+=f16_at(gr+c*2u)*x;us+=f16_at(ur+c*2u)*x;}gp[lane]=gs;up[lane]=us;barrier();for(uint st=128u;st>0u;st>>=1u){if(lane<st){gp[lane]+=gp[lane+st];up[lane]+=up[lane+st];}barrier();}if(lane==0u){float g=gp[0];output_buf.y[pc.output_base+tok*pc.output_stride+row]=(g/(1.0+exp(-g)))*up[0];}}
